<file path="src/pages/Intro.jsx">
import React, { useState, useEffect, useRef } from 'react';
import { useNavigate } from 'react-router-dom';
import { Loader2, Star, Sparkles } from 'lucide-react';

const sectionsData = [
  { title: 'KOSMATE', line1: 'Smart Way to Find Your Stay,', line2: 'No drama, no zonk!', badge: 'Platform Akomodasi Eksklusif' },
  { title: 'VERIFIED', line1: '100% Aman & Terpercaya,', line2: 'Setiap properti diverifikasi untukmu.', badge: 'Keamanan Terjamin' },
  { title: 'SEAMLESS', line1: 'Booking Online Tanpa Drama,', line2: 'Cari, cek, bayar dalam satu aplikasi.', badge: 'Transaksi Mudah' }
];

export default function Intro() {
  const navigate = useNavigate();
  const containerRef = useRef(null);
  const videoRef = useRef(null);
  const requestRef = useRef(null);
  const targetProgress = useRef(0);
  const smoothProgress = useRef(0);
  
  const [scrollProgress, setScrollProgress] = useState(0);
  const [videoDuration, setVideoDuration] = useState(0);
  const [videoSrc, setVideoSrc] = useState(null);
  const [isVideoReady, setIsVideoReady] = useState(false);

  useEffect(() => {
    const loadVideo = async () => {
      try {
        const response = await fetch('/background.mp4'); 
        if (!response.ok) throw new Error("Fallback");
        const blob = await response.blob();
        setVideoSrc(URL.createObjectURL(blob));
        setIsVideoReady(true);
      } catch (error) {
        setVideoSrc('https://assets.mixkit.co/videos/preview/mixkit-modern-apartment-building-exterior-with-balconies-4062-medium.mp4');
        setIsVideoReady(true);
      }
    };
    loadVideo();
  }, []);

  useEffect(() => {
    const handleScroll = () => {
      if (!containerRef.current) return;
      const rect = containerRef.current.getBoundingClientRect();
      const absoluteTop = window.scrollY + rect.top;
      const localScroll = Math.max(0, window.scrollY - absoluteTop);
      const maxScroll = containerRef.current.offsetHeight - window.innerHeight;
      const progress = maxScroll > 0 ? Math.min(localScroll / maxScroll, 1) : 0;
      setScrollProgress(progress);
      targetProgress.current = progress; 
    };
    window.addEventListener('scroll', handleScroll);
    handleScroll(); 
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  useEffect(() => {
    if (!videoRef.current || !isVideoReady) return;
    videoRef.current.pause();
    const animate = () => {
      smoothProgress.current += (targetProgress.current - smoothProgress.current) * 0.08; 
      if (videoRef.current && videoDuration > 0 && videoRef.current.readyState >= 2) {
        let newTime = smoothProgress.current * videoDuration;
        newTime = Math.max(0.1, Math.min(newTime, videoDuration - 0.1));
        try { videoRef.current.currentTime = newTime; } catch (e) {}
      }
      requestRef.current = requestAnimationFrame(animate);
    };
    requestRef.current = requestAnimationFrame(animate);
    return () => { if (requestRef.current) cancelAnimationFrame(requestRef.current); };
  }, [videoDuration, isVideoReady]);

  const isAtEnd = scrollProgress >= 0.90;

  return (
    <div ref={containerRef} className="relative w-full bg-slate-900 text-white">
      <div className="fixed inset-0 w-full h-[100vh] overflow-hidden bg-slate-900 flex items-center justify-center z-0 pointer-events-none">
        {!isVideoReady && (
          <div className="absolute inset-0 z-20 flex flex-col items-center justify-center bg-slate-900 text-teal-400">
            <Loader2 className="w-[48px] h-[48px] animate-spin mb-[16px]" />
            <p className="font-semibold tracking-wider text-sm md:text-base">Menyiapkan Pengalaman Visual...</p>
          </div>
        )}
        <div className="absolute inset-0 origin-center transition-transform duration-100 ease-out" style={{ transform: `scale(${1 + scrollProgress * 0.4}) translateY(${scrollProgress * 5}%)` }}>
          {videoSrc && <video ref={videoRef} src={videoSrc} className="w-full h-full object-cover scale-105" muted playsInline preload="auto" onLoadedMetadata={(e) => { if (e.target.duration && !isNaN(e.target.duration)) setVideoDuration(e.target.duration); }} />}
          <div className="absolute inset-0 bg-slate-900/40 mix-blend-multiply"></div>
          <div className="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/30 to-slate-900/40"></div>
        </div>
        <div className={`absolute bottom-[40px] left-[32px] md:left-[64px] z-10 flex flex-col items-start gap-[12px] transition-opacity duration-500 ${isAtEnd ? 'opacity-0' : 'opacity-100'}`}>
          <div className="w-[192px] h-[4px] bg-white/20 rounded-[999px] overflow-hidden backdrop-blur-sm shrink-0">
            <div className="h-full bg-teal-400 transition-all duration-100 ease-out" style={{ width: `${scrollProgress * 100}%` }} />
          </div>
        </div>
      </div>

      <div className="relative z-10 w-full">
        {sectionsData.map((sec, idx) => {
          const distance = Math.abs(scrollProgress - (idx * (1 / 3)));
          const opacity = 1 - Math.min(distance * 3, 1);
          const scale = 1 - Math.min(distance * 0.1, 0.1);
          return (
            <div key={idx} className="h-[100vh] w-full flex flex-col items-center justify-center px-[16px] pointer-events-none">
              <div className="flex flex-col items-center max-w-[896px] origin-center" style={{ opacity: Math.max(0, opacity), transform: `scale(${scale})`, transition: 'opacity 0.1s, transform 0.1s' }}>
                <div className="inline-flex items-center gap-[8px] px-[16px] py-[8px] rounded-[999px] bg-teal-500/20 text-teal-300 font-medium text-sm md:text-lg mb-[16px] md:mb-[24px] border border-teal-500/30 backdrop-blur-md shrink-0">
                  <Star className="w-[16px] h-[16px] fill-teal-400 shrink-0" /> <span className="whitespace-nowrap">{sec.badge}</span>
                </div>
                <h1 className="font-extrabold tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-300 mb-[16px] drop-shadow-2xl text-center text-4xl md:text-7xl leading-[0.95]">{sec.title}</h1>
                <div className="font-medium text-center space-y-[4px] md:space-y-[8px] drop-shadow-lg text-lg md:text-3xl leading-tight text-teal-50"><p>{sec.line1}</p><p className="text-slate-300/90">{sec.line2}</p></div>
              </div>
            </div>
          );
        })}

        <div className="h-[100vh] w-full flex flex-col items-center justify-center px-[16px]">
          <div className="flex flex-col items-center origin-center text-center" style={{ opacity: Math.max(0, 1 - Math.abs(scrollProgress - 1) * 3), transform: `scale(${1 - Math.min(Math.abs(scrollProgress - 1) * 0.1, 0.1)})`, transition: 'opacity 0.1s, transform 0.1s' }}>
            <h2 className="text-3xl md:text-6xl font-extrabold text-white mb-[32px] leading-[1.1] tracking-tight">Siap Menemukan <br/> Tempat Nyamanmu?</h2>
            <button onClick={() => navigate('/home')} className="group bg-white hover:bg-teal-50 text-slate-900 px-[32px] py-[16px] md:px-[48px] md:py-[24px] rounded-[999px] font-extrabold text-lg md:text-2xl transition-all shadow-[0_0_40px_rgba(255,255,255,0.2)] hover:shadow-[0_0_60px_rgba(20,184,166,0.4)] flex items-center justify-center gap-[16px] hover:-translate-y-[4px] shrink-0 pointer-events-auto">
              <span className="whitespace-nowrap">Mulai Perjalanan</span> 
              <Sparkles className="w-[24px] h-[24px] md:w-[32px] md:h-[32px] text-teal-500 group-hover:rotate-12 group-hover:scale-110 transition-all shrink-0" />
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
