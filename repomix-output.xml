export default function ShadcnNavbar({ isMobileMenuOpen, setIsMobileMenuOpen, onOpenContact, darkTheme = false }) {
  const navigate = useNavigate();
  const location = useLocation();
  
  const [isVisible, setIsVisible] = useState(true);
